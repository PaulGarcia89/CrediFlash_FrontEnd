{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/",
      "destination": "/login",
      "locale": false,
      "statusCode": 308,
      "regex": "^(?!/_next)/(?:/)?$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/clientes/[id]/detalle",
      "regex": "^/clientes/([^/]+?)/detalle(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/clientes/(?<nxtPid>[^/]+?)/detalle(?:/)?$"
    },
    {
      "page": "/clientes/[id]/editar",
      "regex": "^/clientes/([^/]+?)/editar(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
