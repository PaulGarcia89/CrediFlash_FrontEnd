      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/solicitudes/(?<nxtPid>[^/]+?)/editar(?:/)?$"
    },
    {
      "page": "/[...not-found]",
      "regex": "^/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnotfound": "nxtPnot-found"
      },
      "namedRegex": "^/(?<nxtPnotfound>.+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
